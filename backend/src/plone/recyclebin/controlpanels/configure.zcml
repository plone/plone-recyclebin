<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="plone.recyclebin"
    >

  <browser:page
      name="recyclebin-controlpanel"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".recyclebin.RecyclebinControlPanelView"
      permission="plone.recyclebin.AccessRecycleBin"
      />

  <adapter
      factory=".recyclebin.RecyclebinSettingsControlPanel"
      name="recyclebin-settings"
      />

</configure>
